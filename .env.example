# Copy this file to .env only on the server. Never commit the real .env.
# Local home testing may keep 0.0.0.0 so phones on the same Wi-Fi can connect.
# On a public VPS behind Caddy/Nginx use 127.0.0.1 and expose only HTTPS/WSS.
SPARTAN_WS_HOST=0.0.0.0
SPARTAN_WS_PORT=8080
SPARTAN_MEDIA_HOST=0.0.0.0
SPARTAN_MEDIA_PORT=8081

# Keep runtime databases, queues, avatars and media outside the source checkout.
# Example for Linux VPS: /var/lib/spartan-chat
SPARTAN_DATA_DIR=.

# Optional absolute path. Defaults to SPARTAN_DATA_DIR/firebase-service-account.json
# FIREBASE_SERVICE_ACCOUNT_PATH=/run/secrets/spartan-firebase.json

# Message bodies must stay out of production logs. Enable only temporarily on a test server.
SPARTAN_LOG_MESSAGE_CONTENT=false
SPARTAN_LOG_CLIENT_IP=false

# Trust X-Forwarded-For only when the WebSocket server is reachable solely
# through your own reverse proxy. Keep false when port 8080 is public.
SPARTAN_TRUST_PROXY=false

# Attempts allowed for one account from one address, plus the overall limit for
# one address. Successful login clears only the account-specific failure bucket.
SPARTAN_AUTH_MAX_ATTEMPTS=10
SPARTAN_AUTH_IP_MAX_ATTEMPTS=120
SPARTAN_AUTH_WINDOW_MS=900000

# OPENAI_API_KEY is intentionally omitted: provide it through the host secret store.
OPENAI_MODEL=gpt-5-mini
